# ---- Core -------------------------------------------------------------------
DATABASE_URL=postgres://najditech:najditech@localhost:5432/najditech_dev
APP_URL=http://localhost:3000
# development | test | staging | production (default). The mock payment provider is refused in production.
APP_ENV=production
# 32+ random characters. Generate with: openssl rand -base64 48
APP_SECRET=

# ---- Email (transactional + consented marketing) ---------------------------
# "log" prints emails to the server log (development). "resend" sends via Resend.
EMAIL_DRIVER=log
EMAIL_FROM="NajdiTech <no-reply@example.com>"
RESEND_API_KEY=

# ---- Payments ----------------------------------------------------------------
# Comma-separated. Available: bank_transfer, mock (development only; refused in production).
# A real card gateway (Turkish PSP / international) is PENDING merchant approval.
PAYMENT_PROVIDERS=bank_transfer
MOCK_PAYMENT_WEBHOOK_SECRET=

# ---- Analytics (loaded ONLY after the visitor consents) ---------------------
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
# Server-side only. Never prefix with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# ---- Optional AI assistant ---------------------------------------------------
AI_ENABLED=false
ANTHROPIC_API_KEY=

# ---- Storage -----------------------------------------------------------------
STORAGE_DIR=./storage

# ---- Legal / business identity (REQUIRED before launch; see `npm run check:launch`)
# These are shown on the contact, imprint, privacy and terms pages.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Your registered DMCA designated agent (U.S. Copyright Office), if you register one.
NEXT_PUBLIC_DMCA_AGENT=
